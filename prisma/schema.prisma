// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum FeedKind {
    project
    experiment
    about
    client
    service
    note
    read
    talk
    job
    pinned
    page_index
    page_legal
    page_terms
    page_accessibility
    page_accessibility_report
    page_report
}

enum Locale {
  fr
  en
}

model Post {
    id      String      @id @default(cuid())
    
    slug    String @unique

    kind    FeedKind

    pinned Boolean @default(false)

    date DateTime @default(now())

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    
    tags String[] @default([])

    previewUrl String?

    image Json?

    github String?
    demo String?
    website String?

    stack String[] @default([])

    translations PostTranslation[]

    highlighted Boolean @default(false)
}

model PostTranslation {
  id String @id @default(cuid())
  
  locale Locale

  title String

  description String?

  feedTitle   String?
  feedSummary String?

  role String?
  problem String?
  solution String?
  technicalChoices String?
  accessibility String?

  learnings String[] @default([])

  customerName String?
  customerJob String?
  customerCity String?
  customerEnterpriseName String?
  testimony String?

  packages Json?

  blocks Json?

  postId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
}
